# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
VITE_APP_URL="MY_APP_URL"

# Firebase Configuration (browser)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abc123"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Firebase Admin configuration (server): either set the whole service-account JSON as one string,
# or place the JSON in firebase-admin-key.json in the project root.
# Example:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id",...}'
# FIREBASE_SERVICE_ACCOUNT_PATH='/path/to/firebase-admin-key.json'

# Hostinger MySQL (Stage 2 preparation; the app does not use this as primary storage yet)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="YOUR_MYSQL_USER"
MYSQL_PASSWORD="YOUR_MYSQL_PASSWORD"
MYSQL_DATABASE="YOUR_MYSQL_DATABASE"
MYSQL_CONNECTION_LIMIT="5"
MYSQL_SSL="false"
# Set only when MYSQL_SSL=true. Keep true unless your host explicitly requires otherwise.
MYSQL_SSL_REJECT_UNAUTHORIZED="true"
# One-time Hostinger startup switch. Turn it off after logs report a verified migration.
RUN_FIREBASE_MYSQL_MIGRATION_ON_START="false"
# Stage 4: shadow writes to MySQL while Firebase remains the read source.
MYSQL_RUNTIME_STORE_MODE="shadow"

# TURN Server Configuration (for WebRTC voice chat)
# These are required for voice chat to work reliably across different networks.
# You can get free credentials from services like Twilio.
VITE_TURN_URL="turn:your-turn-server.com:3478"
VITE_TURN_USERNAME="your-turn-username"
VITE_TURN_CREDENTIAL="your-turn-password-or-token"
